# ========== Gmail ==========
GMAIL_CREDENTIALS_FILE=config/credentials.json
GMAIL_TOKEN_FILE=config/token.json
# 未读 + 星标；也可用 Gmail 搜索语法
GMAIL_QUERY=is:unread OR is:starred
GMAIL_MAX_RESULTS=50
GMAIL_PROCESSED_LABEL=已处理
GMAIL_MARK_READ=false

# ========== AI ==========
# Gemini 原生示例：
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENAI_API_KEY=your-gemini-api-key
# OPENAI_MODEL=gemini-flash-lite-latest
#
# 或任意 OpenAI 兼容网关（base_url 以 /v1 结尾）：
OPENAI_BASE_URL=https://your-openai-compatible-host/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ========== 飞书（国内版 open.feishu.cn；国际版改 larksuite.com）==========
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxx
FEISHU_APP_TOKEN=bascnxxxxxxxxxxxx
FEISHU_TABLE_ID=tblxxxxxxxxxxxx
# 可选：非邮件待办表 table_id
FEISHU_TODO_TABLE_ID=
# 可选：自定义机器人 webhook，用于 DDL 推送
FEISHU_WEBHOOK_URL=

# ========== DDL 提醒 ==========
REMIND_SOON_DAYS=3

# ========== 回复签名（会出现在建议回复 / 发送末尾）==========
REPLY_SIGNATURE=

# ========== 可选：学校 M365 Graph 兜底 ==========
GRAPH_ENABLED=false
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=common
GRAPH_TOKEN_FILE=config/graph_token.json
GRAPH_MAX_RESULTS=10
